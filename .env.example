# Environment Variables — CoolCycle JWT Bridge
# Copy this file to .env and fill in your values

# ThingsBoard PE Europe Cloud base URL
TB_BASE_URL=https://eu.thingsboard.cloud

# Dashboard IDs (get from ThingsBoard URL when viewing each dashboard)
TB_DASH_DEVELOPER=<ENCRYPTED_DEVELOPER_DASHBOARD_UUID>
TB_DASH_ADMIN=<ENCRYPTED_ADMIN_DASHBOARD_UUID>
TB_DASH_USER=<ENCRYPTED_USER_DASHBOARD_UUID>

# External APIs (Security Placeholders)
TWILIO_ACCOUNT_SID=<ENCRYPTED_TWILIO_SID>
TWILIO_AUTH_TOKEN=<ENCRYPTED_TWILIO_TOKEN>
TWILIO_PHONE_NUMBER=<ENCRYPTED_TWILIO_NUMBER>

# Server port
PORT=3001

# Allowed CORS origin (your website domain)
CORS_ORIGIN=https://coolcycle.com
