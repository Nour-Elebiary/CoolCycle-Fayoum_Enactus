{
  "ruleChain": {
    "name": "CoolCycle WhatsApp Alerts",
    "type": "CORE",
    "firstRuleNodeId": null,
    "root": false,
    "debugMode": false,
    "configuration": null,
    "additionalInfo": null
  },
  "metadata": {
    "nodes": [
      {
        "type": "org.thingsboard.rule.engine.enrichment.TbGetAttributesNode",
        "name": "Fetch Alert Attrs",
        "debugMode": false,
        "configuration": {
          "fetchToData": false,
          "sharedAttributeNames": [
            "alert_whatsapp",
            "clinic_name",
            "clinic_lat",
            "clinic_lon"
          ]
        },
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "additionalInfo": {
          "description": "",
          "layoutX": 150,
          "layoutY": 150
        }
      },
      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Build WhatsApp Message",
        "debugMode": false,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "var alarmType = metadata.alarmType != null ? metadata.alarmType : 'ALERT';\nvar clinic = metadata.clinic_name != null ? metadata.clinic_name : 'Unknown Clinic';\nvar temp = msg.temp_internal != null ? toFixed(msg.temp_internal, 1) + '\u00c2\u00b0C' : 'N/A';\nvar batt = msg.battery_soc != null ? msg.battery_soc + '%' : 'N/A';\nvar lat = metadata.clinic_lat != null ? metadata.clinic_lat : (msg.latitude != null ? msg.latitude : '');\nvar lon = metadata.clinic_lon != null ? metadata.clinic_lon : (msg.longitude != null ? msg.longitude : '');\nvar mapsLink = (lat != '' && lon != '') ? 'https://maps.google.com/?q=' + lat + ',' + lon : 'Location unavailable';\nvar phone = metadata.alert_whatsapp != null ? metadata.alert_whatsapp : '';\nvar body = '\u00f0\u0178\u0161\u00a8 CoolCycle ALERT\\nClinic: ' + clinic + '\\nIssue: ' + alarmType + '\\nTemp: ' + temp + '\\nBattery: ' + batt + '\\nLocation: ' + mapsLink;\nmsg.wa_to = 'whatsapp:+' + phone.replace(/\\D/g, '');\nmsg.wa_body = body;\nreturn {msg: msg, metadata: metadata, msgType: msgType};"
        },
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "additionalInfo": {
          "description": "",
          "layoutX": 400,
          "layoutY": 150
        }
      },
      {
        "type": "org.thingsboard.rule.engine.rest.TbRestApiCallNode",
        "name": "Twilio REST \u00e2\u20ac\u201d Send WhatsApp",
        "debugMode": false,
        "configuration": {
          "restEndpointUrlPattern": "https://api.twilio.com/2010-04-01/Accounts/REPLACE_TWILIO_SID/Messages.json",
          "requestMethod": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "Authorization": "Basic REPLACE_WITH_BASE64_SID_AUTHTOKEN"
          },
          "useSimpleClientHttpFactory": false,
          "bodyTemplate": "From=whatsapp:+14155238886&To=${msg.wa_to}&Body=${msg.wa_body}",
          "parseToPlainText": false
        },
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 3,
        "additionalInfo": {
          "description": "",
          "layoutX": 650,
          "layoutY": 150
        }
      },
      {
        "type": "org.thingsboard.rule.engine.action.TbLogNode",
        "name": "Log WhatsApp Sent",
        "debugMode": false,
        "configuration": {
          "jsScript": "return 'WhatsApp sent for alarm: ' + metadata.alarmType;"
        },
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "additionalInfo": {
          "description": "",
          "layoutX": 150,
          "layoutY": 250
        }
      },
      {
        "type": "org.thingsboard.rule.engine.action.TbLogNode",
        "name": "Log WhatsApp Failed",
        "debugMode": false,
        "configuration": {
          "jsScript": "return 'WhatsApp FAILED for: ' + metadata.alarmType + ' | Error: ' + msg.error;"
        },
        "debugSettings": null,
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "additionalInfo": {
          "description": "",
          "layoutX": 400,
          "layoutY": 250
        }
      }
    ],
    "connections": [
      {
        "fromIndex": 0,
        "toIndex": 1,
        "type": "Success"
      },
      {
        "fromIndex": 1,
        "toIndex": 2,
        "type": "Success"
      },
      {
        "fromIndex": 2,
        "toIndex": 3,
        "type": "Success"
      },
      {
        "fromIndex": 2,
        "toIndex": 4,
        "type": "Failure"
      }
    ],
    "version": 5,
    "firstNodeIndex": 0,
    "ruleChainConnections": null
  }
}