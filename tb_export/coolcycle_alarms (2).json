        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return msg.temperature > 20;",
          "tbelScript": "if (!msg.gps_valid || metadata.clinic_lat == null) return false;\\nvar homeLat = parseFloat(metadata.clinic_lat);\\nvar homeLon = parseFloat(metadata.clinic_lon);\\nvar fence = parseFloat(metadata.geofence_radius_m != null ? metadata.geofence_radius_m : '500');\\nvar R = 6371000;\\nvar dLat = (msg.latitude - homeLat) * Math.PI / 180;\\nvar dLon = (msg.longitude - homeLon) * Math.PI / 180;\\nvar a = Math.sin(dLat/2)*Math.sin(dLat/2) + Math.cos(homeLat*Math.PI/180)*Math.cos(msg.latitude*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);\\nvar dist = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));\\nreturn dist > fence;"
        },
