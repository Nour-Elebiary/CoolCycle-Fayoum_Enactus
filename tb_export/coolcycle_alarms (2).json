      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Build WhatsApp Message",
        "debugSettings": {
          "failuresEnabled": false,
          "allEnabled": false,
          "allEnabledUntil": 0
        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "",
          "tbelScript": "var alarmType = metadata.alarmType != null ? metadata.alarmType : 'ALERT';\r\nvar clinic = metadata.clinic_name != null ? metadata.clinic_name : 'Unknown Clinic';\r\nvar temp = msg.temp_internal != null ? toFixed(msg.temp_internal, 1) + '°C' : 'N/A';\r\nvar batt = msg.battery_soc != null ? msg.battery_soc + '%' : 'N/A';\r\nvar lat = metadata.clinic_lat != null ? metadata.clinic_lat : (msg.latitude != null ? msg.latitude : '');\r\nvar lon = metadata.clinic_lon != null ? metadata.clinic_lon : (msg.longitude != null ? msg.longitude : '');\r\nvar mapsLink = (lat != '' && lon != '') ? 'https://maps.google.com/?q=' + lat + ',' + lon : 'Location unavailable';\r\n\r\nvar phone = metadata.alert_whatsapp != null ? metadata.alert_whatsapp : '';\r\n\r\n// Build the text message\r\nvar bodyText = \"🚨 CoolCycle ALERT\\n\" +\r\n               \"Clinic: \" + clinic + \"\\n\" +\r\n               \"Issue: \" + alarmType + \"\\n\" +\r\n               \"Temp: \" + temp + \"\\n\" +\r\n               \"Battery: \" + batt + \"\\n\" +\r\n               \"Location: \" + mapsLink;\r\n\r\n// URL Encode the variables for Twilio (application/x-www-form-urlencoded)\r\nvar fromParam = encodeURIComponent(\"whatsapp:+14155238886\"); // Change this if you have a different Twilio WhatsApp sender number\r\nvar toParam = encodeURIComponent(\"whatsapp:+\" + phone.replace(/\\D/g, ''));\r\nvar bodyParam = encodeURIComponent(bodyText);\r\n\r\n// Build the final payload string\r\nvar twilioPayload = \"From=\" + fromParam + \"&To=\" + toParam + \"&Body=\" + bodyParam;\r\n\r\n// Return the payload as a raw string\r\nreturn {msg: twilioPayload, metadata: metadata, msgType: msgType};\r\n"
        },
        "additionalInfo": {
          "description": "",
          "layoutX": 1078,
          "layoutY": 171
        }
